---
// Sección "Nosotros": quiénes somos, cómo trabajamos y los socios.
// Los socios se configuran en src/data/equipo.ts y solo se muestran
// cuando los tres están completos.
import { Icon } from "astro-icon/components";
import { equipo, equipoCompleto, iniciales } from "../../data/equipo";

const diferenciales = [
  {
    icono: "lucide:message-circle",
    titulo: "Hablas con quien hace el trabajo",
    texto: "Sin intermediarios ni ejecutivos de cuenta. Te responde el ingeniero que construye tu proyecto.",
  },
  {
    icono: "lucide:gauge",
    titulo: "Sitios rápidos y medibles",
    texto: "Cada web sale con WhatsApp, formulario y medición de visitas listos desde el primer día.",
  },
  {
    icono: "lucide:map-pin",
    titulo: "Cerca de tu negocio",
    texto: "Estamos en La Serena. Nos juntamos contigo en la Región de Coquimbo o por videollamada.",
  },
];
---

<section id="nosotros" class="relative overflow-hidden py-16 lg:py-24">
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute -top-24 left-1/4 h-96 w-96 rounded-full bg-sky-500/10 blur-3xl dark:bg-sky-400/5"></div>
    <div class="absolute bottom-0 right-1/4 h-96 w-96 rounded-full bg-blue-500/10 blur-3xl dark:bg-blue-400/5"></div>
  </div>

  <div class="container mx-auto px-6 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-center lg:gap-16">
      <div class="space-y-6" data-reveal="fade-up">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-accent dark:text-highlight">
          Nosotros
        </p>
        <h2
          id="about-title"
          class="text-3xl font-bold tracking-tight text-content [text-wrap:balance] sm:text-4xl lg:text-5xl"
        >
          Ingenieros en informática que trabajan para pymes
        </h2>
        <p class="max-w-prose text-lg leading-relaxed text-muted">
          Somos un equipo de ingenieros en informática en La Serena. Hacemos
          páginas web, sistemas y campañas con el mismo criterio técnico con
          que se construye software serio, pero explicado en simple y pensado
          para que tu negocio reciba más consultas.
        </p>
      </div>

      <ul class="grid gap-4" data-reveal="fade-up" data-delay="120">
        {diferenciales.map((item) => (
          <li class="flex items-start gap-4 rounded-2xl border border-border/70 bg-card/80 p-5 backdrop-blur-sm">
            <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary dark:bg-highlight/10 dark:text-highlight">
              <Icon name={item.icono} class="h-5 w-5" aria-hidden="true" />
            </span>
            <span>
              <span class="block text-base font-semibold text-content">{item.titulo}</span>
              <span class="mt-1 block text-sm leading-relaxed text-muted">{item.texto}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>

    {equipoCompleto && (
      <div class="mt-16 lg:mt-20">
        <h3 class="text-center text-2xl font-semibold text-content sm:text-3xl">
          Los socios
        </h3>
        <div class="mx-auto mt-10 grid max-w-5xl gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {equipo.map((socio, index) => (
            <article
              class="group overflow-hidden rounded-2xl border border-border/70 bg-card"
              data-reveal="fade-up"
              data-delay={String(index * 80)}
            >
              <div class="team-photo relative aspect-[4/3] overflow-hidden sm:aspect-[4/5]">
                {socio.foto ? (
                  <img
                    src={socio.foto}
                    alt={`${socio.nombre}, ${socio.rol}`}
                    class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="absolute inset-0 flex items-center justify-center text-6xl font-bold tracking-tight text-white/90">
                    {iniciales(socio.nombre)}
                  </span>
                )}
              </div>
              <div class="space-y-1 p-6">
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <p class="text-lg font-semibold text-content">{socio.nombre}</p>
                    <p class="text-sm font-medium text-accent dark:text-highlight">{socio.rol}</p>
                  </div>
                  {socio.linkedin && (
                    <a
                      href={socio.linkedin}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`LinkedIn de ${socio.nombre}`}
                      class="text-muted transition hover:text-content"
                    >
                      <Icon name="simple-icons:linkedin" class="h-5 w-5" />
                    </a>
                  )}
                </div>
                <p class="text-xs uppercase tracking-[0.16em] text-muted">{socio.titulo}</p>
                {socio.enfoque && <p class="pt-2 text-sm leading-relaxed text-muted">{socio.enfoque}</p>}
              </div>
            </article>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .team-photo {
    background: linear-gradient(135deg, rgb(var(--color-primary)) 0%, rgb(20 40 95) 100%);
  }
</style>
