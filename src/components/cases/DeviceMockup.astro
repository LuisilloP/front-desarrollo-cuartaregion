---
/**
 * Marco de laptop + celular hecho en CSS para mostrar un proyecto.
 * Usa la misma imagen en ambos; el celular muestra la parte superior
 * izquierda. Cuando existan capturas móviles reales, pasa `mobileImage`.
 */
interface Props {
  image: string;
  alt: string;
  mobileImage?: string;
  class?: string;
}

const { image, alt, mobileImage, class: className } = Astro.props as Props;
---

<div class:list={["relative mx-auto w-full max-w-3xl pb-8 pr-6 sm:pr-10", className]}>
  <!-- Laptop -->
  <div class="relative">
    <div class="rounded-t-2xl border border-slate-700/80 bg-slate-900 p-2 shadow-2xl sm:p-3">
      <div class="mb-2 flex items-center gap-1.5 px-1" aria-hidden="true">
        <span class="h-2 w-2 rounded-full bg-slate-600"></span>
        <span class="h-2 w-2 rounded-full bg-slate-600"></span>
        <span class="h-2 w-2 rounded-full bg-slate-600"></span>
      </div>
      <div class="aspect-[16/10] overflow-hidden rounded-md bg-slate-800">
        <img
          src={image}
          alt={alt}
          class="h-full w-full object-cover object-left-top"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
    <div
      class="mx-auto h-3 w-[108%] -translate-x-[3.7%] rounded-b-xl border border-t-0 border-slate-400/60 bg-gradient-to-b from-slate-300 to-slate-400 dark:border-slate-600 dark:from-slate-600 dark:to-slate-700"
      aria-hidden="true"
    >
    </div>
  </div>

  <!-- Celular -->
  <div
    class="absolute bottom-0 right-0 w-[24%] min-w-[84px] max-w-[150px] rounded-[1.4rem] border border-slate-700/80 bg-slate-900 p-1.5 shadow-2xl"
    aria-hidden="true"
  >
    <div class="mx-auto mb-1 h-1 w-8 rounded-full bg-slate-700"></div>
    <div class="aspect-[9/19] overflow-hidden rounded-[1rem] bg-slate-800">
      <img
        src={mobileImage ?? image}
        alt=""
        class="h-full w-full object-cover object-left-top"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</div>
