---
/**
 * Preguntas frecuentes al final del artículo. El schema FAQPage lo genera
 * la página del artículo a partir del frontmatter `faq`.
 */
interface Props {
  items: Array<{ question: string; answer: string }>;
}

const { items } = Astro.props as Props;
---

{items.length > 0 && (
  <section aria-labelledby="faq-articulo" class="mt-14">
    <h2 id="faq-articulo" class="text-2xl font-bold tracking-tight text-content">
      Preguntas frecuentes
    </h2>
    <div class="mt-6 divide-y divide-border/70 rounded-2xl border border-border/70 bg-card">
      {items.map((item) => (
        <details class="group p-5 sm:px-6">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-semibold text-content">
            {item.question}
            <span class="mt-0.5 text-xl leading-none text-muted transition group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 leading-relaxed text-muted">{item.answer}</p>
        </details>
      ))}
    </div>
  </section>
)}
