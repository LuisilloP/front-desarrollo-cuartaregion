---
import PostCard from "./PostCard.astro";
import type { PostBlog } from "../../lib/blog";

interface Props {
  posts: PostBlog[];
}

const { posts } = Astro.props as Props;
---

{posts.length > 0 && (
  <section aria-labelledby="relacionados" class="section-shell mt-20">
    <h2 id="relacionados" class="text-2xl font-bold tracking-tight text-content sm:text-3xl">
      Sigue leyendo
    </h2>
    <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
)}
