---
import type { SiteSettings } from "../lib/api/types";
import { env } from "../lib/env";
import { SITE_DEFAULTS } from "../config/site";
import { LEGAL_INFO } from "../config/legal";

export interface Props {
    title?: string;
    description?: string;
    image?: string;
    imageAlt?: string;
    siteSettings?: SiteSettings;
    ogType?: "website" | "article";
    article?: {
        publishedTime?: string;
        modifiedTime?: string;
        section?: string;
        tags?: string[];
    };
    noindex?: boolean;
    structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
    title,
    description,
    image,
    imageAlt,
    siteSettings,
    ogType = "website",
    article,
    noindex,
    structuredData,
} = Astro.props;

const siteName = siteSettings?.siteName ?? SITE_DEFAULTS.siteName;
const tagline = siteSettings?.tagline ?? SITE_DEFAULTS.tagline;
const whatsappNumber = siteSettings?.whatsappNumber ?? SITE_DEFAULTS.whatsappNumber;
const region = siteSettings?.region ?? SITE_DEFAULTS.region;
const socialLinks = siteSettings?.socialLinks ?? [];

const pageTitle = title
    ? title.includes(siteName)
        ? title
        : `${title} | ${siteName}`
    : `${siteName} | ${tagline}`;

const pageDescription = description || tagline;
const canonical = Astro.url ? Astro.url.toString() : undefined;
const siteUrl = env.siteUrl ?? (Astro.site ? Astro.site.toString() : undefined);

// Ensure image is absolute and valid for OG
// Use logo as the default share image
const defaultOgImage = SITE_DEFAULTS.defaultOgImage;
const ogImage = image || defaultOgImage;

const resolvedOgImage =
    ogImage.startsWith("http") || !siteUrl
        ? ogImage
        : new URL(ogImage, siteUrl).toString();

const resolvedCanonical = canonical ?? siteUrl;
const ogImageAlt = imageAlt || title || siteName;

// Determine image type based on extension (simple heuristic)
const imageExt = resolvedOgImage.split(".").pop()?.toLowerCase();
const ogImageType =
    imageExt === "png"
        ? "image/png"
        : imageExt === "jpg" || imageExt === "jpeg"
          ? "image/jpeg"
          : "image/webp";

const robotsDirective = noindex
    ? "noindex, nofollow"
    : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

// Schema.org - LocalBusiness
//
// The type must be a real schema.org term. This previously declared
// ["ProfessionalService", "MarketingAgency", "WebDevelopment"]; the last two
// do not exist in the vocabulary, and an invalid type can make Google discard
// the whole entity. ProfessionalService is a LocalBusiness subtype and is
// what Google expects for an agency.
//
// The address comes from LEGAL_INFO so the NAP (name, address, phone) stays
// identical to the footer, /informacion-legal and the Google Business Profile.
// Local ranking depends on those three matching exactly.
const { address: legalAddress } = LEGAL_INFO;

// schema.org/telephone expects E.164. getWhatsAppPhone() strips the plus
// because wa.me links need bare digits, so it goes back on here.
const schemaTelephone = whatsappNumber.startsWith("+")
    ? whatsappNumber
    : `+${whatsappNumber}`;

const localBusinessSchema = {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    name: siteName,
    legalName: LEGAL_INFO.legalName,
    url: siteUrl,
    logo: siteUrl ? new URL("/logo.webp", siteUrl).toString() : undefined,
    image: resolvedOgImage,
    description: pageDescription,
    address: {
        "@type": "PostalAddress",
        streetAddress: legalAddress.street,
        addressLocality: legalAddress.locality,
        addressRegion: legalAddress.region,
        addressCountry: legalAddress.country,
    },
    areaServed: [
        { "@type": "AdministrativeArea", name: region },
        { "@type": "City", name: "La Serena" },
        { "@type": "City", name: "Coquimbo" },
        { "@type": "City", name: "Ovalle" },
    ],
    priceRange: "$$", // Reasonable default for agencies
    telephone: schemaTelephone,
    email: LEGAL_INFO.email,
    openingHoursSpecification: [
        {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
            opens: "09:00",
            closes: "18:00",
        },
    ],
    sameAs: socialLinks.map((link) => link.url),
};
---

<!-- Canonical URL -->
{resolvedCanonical && <link rel="canonical" href={resolvedCanonical} />}

<!-- Primary Meta Tags -->
<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={pageDescription} />
<meta name="robots" content={robotsDirective} />
<meta name="googlebot" content={robotsDirective} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={resolvedCanonical} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:image" content={resolvedOgImage} />
<meta property="og:image:type" content={ogImageType} />
<!-- We hint decent dimensions for the hero image to encourage large card display -->
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="es_CL" />

<!-- Twitter -->
<!-- The fallback image is now a real 1200x630 card, so the large layout
     applies whether or not the page supplied its own image. -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={resolvedCanonical} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={resolvedOgImage} />

<!-- Article Metadata (if applicable) -->
{
    ogType === "article" && article && (
        <>
            {article.publishedTime && (
                <meta
                    property="article:published_time"
                    content={article.publishedTime}
                />
            )}
            {article.modifiedTime && (
                <meta
                    property="article:modified_time"
                    content={article.modifiedTime}
                />
            )}
            {article.section && (
                <meta property="article:section" content={article.section} />
            )}
            {article.tags?.map((tag) => (
                <meta property="article:tag" content={tag} />
            ))}
        </>
    )
}

<!-- Schema.org JSON-LD -->
<script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(localBusinessSchema)}
/>
{
    structuredData &&
        (Array.isArray(structuredData) ? (
            structuredData.map((item) => (
                <script
                    is:inline
                    type="application/ld+json"
                    set:html={JSON.stringify(item)}
                />
            ))
        ) : (
            <script
                is:inline
                type="application/ld+json"
                set:html={JSON.stringify(structuredData)}
            />
        ))
}

