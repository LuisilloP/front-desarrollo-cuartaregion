---
import PlanCard from "./PlanCard.astro";
import { planesComoTarjetas } from "../../data/planes";
import { buildWhatsAppLink } from "../../lib/utils";

interface Props {
  title: string;
  description: string;
  whatsappNumber?: string;
}

const { title, description, whatsappNumber } = Astro.props as Props;

// Precios desde la fuente única (src/data/planes.ts)
const plans = planesComoTarjetas(
  (mensaje) => buildWhatsAppLink(whatsappNumber, mensaje) ?? "#contacto-marketing",
);
---

<section id="planes" class="scroll-mt-28 py-20 lg:py-32">
  <div class="section-shell">
    <div class="mx-auto max-w-3xl text-center" data-reveal="fade-up">
      <h2 class="text-3xl font-semibold text-content sm:text-4xl">
        {title}
      </h2>
      <p class="mt-4 text-lg text-muted">
        {description}
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {plans.map((plan, index) => (
        <div
          id={plan.id}
          class="h-full scroll-mt-28"
          data-reveal="fade-up"
          data-delay={String(index * 80)}
        >
          <PlanCard plan={plan} />
        </div>
      ))}
    </div>
  </div>
</section>
