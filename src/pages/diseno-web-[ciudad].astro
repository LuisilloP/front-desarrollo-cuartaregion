---
/**
 * City landing pages: /diseno-web-la-serena, /diseno-web-coquimbo, ...
 *
 * The keyword and the city both sit in the URL because that is the query
 * being targeted. Content comes from src/config/cities.ts, where each city
 * carries its own copy and its own real clients - see the note there on why
 * these must never become near-duplicates of each other.
 */
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import WhatsAppFloatingButton from "../components/layout/WhatsAppFloatingButton.astro";
import CaseCard from "../components/ui/CaseCard.astro";
import { CITY_LANDINGS, type CityLanding } from "../config/cities";
import { companies } from "../content/portfolioProjects";
import { fetchCases, fetchSiteSettings } from "../lib/api/services";
import { buildWhatsAppLink } from "../lib/utils";
import { env } from "../lib/env";
import { LEGAL_INFO } from "../config/legal";

export async function getStaticPaths() {
  return CITY_LANDINGS.map((entry) => ({
    params: { ciudad: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CityLanding };

const siteSettings = await fetchSiteSettings();
const allCases = await fetchCases();

// Only the cases this city actually has. Order follows the config so the
// strongest work leads.
const cityCases = entry.caseSlugs
  .map((slug) => allCases.find((item) => item.slug === slug))
  .filter((item): item is NonNullable<typeof item> => Boolean(item));

// Clients with no published case study still count as proof of local work.
const cityBrands = entry.brandIds
  .map((id) => companies.find((company) => company.id === id))
  .filter((company): company is NonNullable<typeof company> => Boolean(company));

const hasWork = cityCases.length > 0 || cityBrands.length > 0;

const whatsappUrl = buildWhatsAppLink(
  siteSettings.whatsappNumber,
  `Hola! Quiero cotizar una pagina web en ${entry.city}.`,
);

const siteUrl = env.siteUrl ?? (Astro.site ? Astro.site.toString() : undefined);
const toAbsolute = (path: string) =>
  siteUrl ? new URL(path, siteUrl).toString() : path;
const canonical = Astro.url
  ? Astro.url.toString()
  : toAbsolute(`/diseno-web-${entry.slug}/`);

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: entry.heading,
  description: entry.description,
  url: canonical,
  serviceType: "Diseño y desarrollo web",
  areaServed: {
    "@type": "City",
    name: entry.city,
    containedInPlace: {
      "@type": "AdministrativeArea",
      name: "Región de Coquimbo",
    },
  },
  provider: {
    "@type": "ProfessionalService",
    name: siteSettings.siteName,
    url: siteUrl,
    telephone: LEGAL_INFO.phoneTel,
    address: {
      "@type": "PostalAddress",
      streetAddress: LEGAL_INFO.address.street,
      addressLocality: LEGAL_INFO.address.locality,
      addressRegion: LEGAL_INFO.address.region,
      addressCountry: LEGAL_INFO.address.country,
    },
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: toAbsolute("/") },
    {
      "@type": "ListItem",
      position: 2,
      name: "Desarrollo",
      item: toAbsolute("/desarrollo/"),
    },
    { "@type": "ListItem", position: 3, name: entry.heading, item: canonical },
  ],
};

// Links to the sibling cities, so each page is reachable from the others.
const otherCities = CITY_LANDINGS.filter((item) => item.slug !== entry.slug);
---

<Layout
  title={entry.title}
  description={entry.description}
  siteSettings={siteSettings}
  structuredData={[serviceSchema, breadcrumbSchema]}
>
  <Navbar siteSettings={siteSettings} />

  <main class="hero-safe-offset">
    <section class="section-shell py-16 lg:py-24">
      <nav aria-label="Ruta de navegación" class="mb-6 text-sm text-muted">
        <a href="/" class="hover:text-content">Inicio</a>
        <span aria-hidden="true" class="px-2">/</span>
        <a href="/desarrollo" class="hover:text-content">Desarrollo</a>
        <span aria-hidden="true" class="px-2">/</span>
        <span class="text-content">{entry.city}</span>
      </nav>

      <p
        class="inline-flex items-center rounded-full border border-border bg-surface-strong/70 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-muted"
      >
        {entry.area} · Región de Coquimbo
      </p>

      <h1
        class="mt-5 max-w-3xl text-4xl font-bold tracking-tight text-content sm:text-5xl"
      >
        {entry.heading}
      </h1>

      <div class="mt-6 max-w-2xl space-y-4">
        {
          entry.intro.map((paragraph) => (
            <p class="text-lg leading-relaxed text-muted">{paragraph}</p>
          ))
        }
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-2xl bg-primary px-6 py-3 text-sm font-semibold text-contrast transition-opacity hover:opacity-90"
        >
          Cotizar por WhatsApp
        </a>
        <a
          href="/desarrollo#planes"
          class="inline-flex items-center justify-center rounded-2xl border border-border bg-card px-6 py-3 text-sm font-semibold text-content transition-colors hover:bg-surface-strong"
        >
          Ver planes y precios
        </a>
      </div>
    </section>

    {
      hasWork && (
        <section class="section-shell pb-16 lg:pb-24">
          <h2 class="text-2xl font-bold tracking-tight text-content sm:text-3xl">
            {entry.workIntro}
          </h2>

          {cityCases.length > 0 && (
            <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
              {cityCases.map((caseItem) => (
                <CaseCard caseItem={caseItem} />
              ))}
            </div>
          )}

          {cityBrands.length > 0 && (
            <ul class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-3 sm:gap-8 lg:grid-cols-4">
              {cityBrands.map((company) => (
                <li class="group w-full rounded-[2rem]">
                  <a
                    href={company.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block transition-transform duration-300 ease-in-out hover:-translate-y-1.5"
                  >
                    <figure class="flex flex-col gap-3">
                      <div class="flex aspect-[4/3] w-full items-center justify-center overflow-hidden rounded-[1.75rem] bg-white/80 p-6 shadow-lg ring-1 ring-border/60 transition-shadow duration-300 group-hover:shadow-2xl dark:bg-white/[0.06]">
                        <img
                          src={company.logo}
                          alt={`Logo de ${company.name}`}
                          class="max-h-full w-full object-contain"
                          loading="lazy"
                          width={220}
                          height={165}
                        />
                      </div>
                      <figcaption class="truncate px-2 text-center text-sm font-semibold text-content">
                        {company.name}
                      </figcaption>
                    </figure>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </section>
      )
    }

    <section class="section-shell pb-20 lg:pb-28">
      <div class="rounded-3xl border border-border bg-surface-strong/50 p-8 sm:p-10">
        <h2 class="text-2xl font-bold tracking-tight text-content sm:text-3xl">
          ¿Tu negocio no está en {entry.city}?
        </h2>
        <p class="mt-3 max-w-2xl text-lg text-muted">
          Trabajamos en toda la Región de Coquimbo y con clientes del resto de
          Chile. Estas son las otras ciudades donde tenemos proyectos
          publicados:
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          {
            otherCities.map((item) => (
              <a
                href={`/diseno-web-${item.slug}`}
                class="inline-flex items-center rounded-2xl border border-border bg-card px-5 py-2.5 text-sm font-semibold text-content transition-colors hover:bg-surface-strong"
              >
                Diseño web en {item.city}
              </a>
            ))
          }
          <a
            href="/desarrollo"
            class="inline-flex items-center rounded-2xl border border-border bg-card px-5 py-2.5 text-sm font-semibold text-content transition-colors hover:bg-surface-strong"
          >
            Ver todos los servicios
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer siteSettings={siteSettings} />
  <WhatsAppFloatingButton whatsappNumber={siteSettings.whatsappNumber} />
</Layout>
