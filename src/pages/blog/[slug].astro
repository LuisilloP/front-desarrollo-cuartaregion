---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
import WhatsAppFloatingButton from "../../components/layout/WhatsAppFloatingButton.astro";
import TOC from "../../components/blog/TOC.astro";
import FAQ from "../../components/blog/FAQ.astro";
import AuthorBox from "../../components/blog/AuthorBox.astro";
import RelatedPosts from "../../components/blog/RelatedPosts.astro";
import ArticleCTA from "../../components/blog/ArticleCTA.astro";
import VideoEmbed from "../../components/blog/VideoEmbed.astro";
import { render } from "astro:content";
import { Icon } from "astro-icon/components";
import { fetchSiteSettings } from "../../lib/api/services";
import { obtenerPosts, postsRelacionados, type PostBlog } from "../../lib/blog";
import { AUTOR_EQUIPO, categoriaPorSlug, formatoFecha, minutosLectura } from "../../data/blog";
import type { Content } from "../../lib/api/types";
import contentJson from "../../data/content.json";
import { env } from "../../lib/env";

export async function getStaticPaths() {
  const posts = await obtenerPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, relacionados: postsRelacionados(post, posts) },
  }));
}

const { post, relacionados } = Astro.props as { post: PostBlog; relacionados: PostBlog[] };
const { Content: Cuerpo, headings } = await render(post);
const content = contentJson as Content;
const siteSettings = await fetchSiteSettings();

const { title, description, pubDate, updatedDate, category, tags, author, cover, coverAlt, faq } = post.data;
const categoria = categoriaPorSlug(category);
const autor = author?.trim() || AUTOR_EQUIPO;
const minutos = minutosLectura(post.body ?? "");

const siteUrl = env.siteUrl ?? (Astro.site ? Astro.site.toString() : undefined);
const toAbsolute = (path: string) => (siteUrl ? new URL(path, siteUrl).toString() : path);
const canonical = toAbsolute(`/blog/${post.id}/`);
const logoUrl = toAbsolute("/logo.svg");
const publisher = {
  "@type": "Organization",
  name: siteSettings.siteName,
  logo: { "@type": "ImageObject", url: logoUrl },
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
  ...(cover ? { image: toAbsolute(cover) } : {}),
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  articleSection: categoria?.nombre,
  ...(tags.length > 0 ? { keywords: tags.join(", ") } : {}),
  inLanguage: "es-CL",
  author:
    autor === AUTOR_EQUIPO
      ? { "@type": "Organization", name: siteSettings.siteName, url: toAbsolute("/") }
      : { "@type": "Person", name: autor },
  publisher,
};
const faqSchema =
  faq.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faq.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: { "@type": "Answer", text: item.answer },
        })),
      }
    : null;
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: toAbsolute("/") },
    { "@type": "ListItem", position: 2, name: "Blog", item: toAbsolute("/blog/") },
    ...(categoria
      ? [{ "@type": "ListItem", position: 3, name: categoria.nombre, item: toAbsolute(`/blog/categoria/${categoria.slug}/`) }]
      : []),
    { "@type": "ListItem", position: categoria ? 4 : 3, name: title, item: canonical },
  ],
};
const structuredData = [articleSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
---

<Layout
  title={`${title} | ${siteSettings.siteName}`}
  description={description}
  siteSettings={siteSettings}
  image={cover}
  imageAlt={coverAlt ?? title}
  ogType="article"
  article={{
    publishedTime: pubDate.toISOString(),
    modifiedTime: (updatedDate ?? pubDate).toISOString(),
    section: categoria?.nombre,
    tags,
  }}
  structuredData={structuredData}
>
  <link slot="head" rel="alternate" type="application/rss+xml" title="Blog de Aliado Digital" href="/blog/rss.xml" />
  <Navbar siteSettings={siteSettings} navLinks={content.navLinks} />

  <main class="hero-safe-offset overflow-x-hidden pb-24">
    <article>
      <header class="section-shell pt-10 sm:pt-14">
        <nav aria-label="Ruta" class="flex flex-wrap items-center gap-1.5 text-sm text-muted">
          <a href="/blog" class="hover:text-content">Blog</a>
          {categoria && (
            <>
              <Icon name="lucide:chevron-right" class="h-3.5 w-3.5" aria-hidden="true" />
              <a href={`/blog/categoria/${categoria.slug}`} class="hover:text-content">{categoria.nombre}</a>
            </>
          )}
        </nav>
        <h1 class="mt-5 max-w-4xl text-3xl font-bold leading-tight tracking-tight text-content [text-wrap:balance] sm:text-4xl lg:text-5xl">
          {title}
        </h1>
        <p class="mt-5 max-w-3xl text-lg leading-relaxed text-muted">{description}</p>
        <p class="mt-6 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted">
          <span class="font-medium text-content">{autor}</span>
          <span aria-hidden="true">·</span>
          <time datetime={pubDate.toISOString()}>{formatoFecha(pubDate)}</time>
          {updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>Actualizado el <time datetime={updatedDate.toISOString()}>{formatoFecha(updatedDate)}</time></span>
            </>
          )}
          <span aria-hidden="true">·</span>
          <span>{minutos} min de lectura</span>
        </p>
        {cover && (
          <img
            src={cover}
            alt={coverAlt ?? title}
            class="mt-10 aspect-[2/1] w-full rounded-3xl object-cover"
            loading="eager"
            decoding="async"
          />
        )}
      </header>

      <div class="section-shell mt-10 grid gap-10 lg:mt-14 lg:grid-cols-[minmax(0,1fr)_260px] lg:gap-16">
        <div class="min-w-0 max-w-3xl">
          <div class="lg:hidden"><TOC headings={headings} /></div>
          <div class="article-body mt-8 lg:mt-0">
            <Cuerpo components={{ ArticleCTA, VideoEmbed }} />
          </div>
          <FAQ items={faq} />
          <AuthorBox author={author} />
        </div>
        <aside class="hidden lg:block">
          <div class="sticky top-28 space-y-6">
            <TOC headings={headings} />
          </div>
        </aside>
      </div>
    </article>

    <RelatedPosts posts={relacionados} />
  </main>

  <Footer siteSettings={siteSettings} navLinks={content.navLinks} legalPages={content.legalPages} />
  <WhatsAppFloatingButton whatsappNumber={siteSettings.whatsappNumber} message={`Hola, leí "${title}" y tengo una consulta.`} />
</Layout>
