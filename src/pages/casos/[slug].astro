---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
import WhatsAppFloatingButton from "../../components/layout/WhatsAppFloatingButton.astro";
import DeviceMockup from "../../components/cases/DeviceMockup.astro";
import { fetchCases, fetchSiteSettings } from "../../lib/api/services";
import type { CaseStudy, Content } from "../../lib/api/types";
import { buildWhatsAppLink } from "../../lib/utils";
import { ordenarCasos } from "../../data/casos";
import contentJson from "../../data/content.json";
import { Icon } from "astro-icon/components";
import { env } from "../../lib/env";

export async function getStaticPaths() {
  const cases = ordenarCasos(
    (await fetchCases()).filter((item) => Boolean(item.slug)),
  );
  return cases.map((item, index) => ({
    params: { slug: item.slug },
    props: {
      caseStudy: item,
      nextCase: cases.length > 1 ? cases[(index + 1) % cases.length] : undefined,
    },
  }));
}

const { caseStudy, nextCase } = Astro.props as {
  caseStudy: CaseStudy;
  nextCase?: CaseStudy;
};
if (!caseStudy) throw new Error("Case study not found");

const content = contentJson as Content;
const siteSettings = await fetchSiteSettings();

const clean = (value?: string | null) =>
  typeof value === "string" ? value.trim() : "";

const clientName = clean(caseStudy.clientName);
const pageTitle = clean(caseStudy.title) || clientName || "Caso";
const headline = clean(caseStudy.headline) || pageTitle;
const seoTitle = `Caso ${clientName || pageTitle} | ${siteSettings.siteName}`;
const summary = clean(caseStudy.summary);
const industry = clean(caseStudy.industry);
const city = clean(caseStudy.city);
const service = clean(caseStudy.service);
const logo = clean(caseStudy.logo);
const coverImage = clean(caseStudy.coverImage);
const coverAlt =
  clean(caseStudy.coverImageAlt) || `Sitio de ${clientName || pageTitle}`;

// --- Enlace real al sitio -------------------------------------------------
const normalizeUrl = (value?: string | null) => {
  const trimmed = clean(value);
  if (!trimmed) return undefined;
  return /^https?:\/\//.test(trimmed) ? trimmed : `https://${trimmed}`;
};
const siteLink = normalizeUrl(caseStudy.siteUrl);
const siteLabel = siteLink
  ? siteLink.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "")
  : "";
const siteIsSocial = siteLink ? /instagram\.com|facebook\.com/.test(siteLink) : false;

// --- Métricas con número (solo se muestran si existen) -------------------
const metrics = (caseStudy.impactMetrics ?? [])
  .filter((metric) => clean(metric?.value) && clean(metric?.label))
  .slice(0, 3);

// --- Problema y lo que hicimos -------------------------------------------
const toTexts = (
  points: CaseStudy["beforePoints"],
  fallback: string | string[] | undefined,
) => {
  const fromPoints = (points ?? []).map((point) => clean(point?.text)).filter(Boolean);
  if (fromPoints.length > 0) return fromPoints;
  return (Array.isArray(fallback) ? fallback : fallback ? [fallback] : [])
    .map((text) => clean(text))
    .filter(Boolean);
};
const problemPoints = toTexts(caseStudy.beforePoints, caseStudy.problem);
const steps = (caseStudy.steps ?? []).filter((step) => clean(step?.title));
const donePoints = toTexts(caseStudy.afterPoints, caseStudy.results);

const testimonial =
  caseStudy.testimonial && clean(caseStudy.testimonial.quote) && clean(caseStudy.testimonial.name)
    ? caseStudy.testimonial
    : undefined;

// --- CTA --------------------------------------------------------------------
const whatsappUrl = buildWhatsAppLink(
  siteSettings.whatsappNumber,
  `Hola! Vi el caso de ${clientName || pageTitle} y quiero algo así para mi negocio.`,
);

// --- Datos estructurados --------------------------------------------------
const siteUrl = env.siteUrl ?? (Astro.site ? Astro.site.toString() : undefined);
const toAbsolute = (path: string) =>
  siteUrl ? new URL(path, siteUrl).toString() : path;
const canonical = Astro.url
  ? Astro.url.toString()
  : toAbsolute(`/casos/${caseStudy.slug}/`);
const logoUrl = siteUrl ? new URL("/logo.svg", siteUrl).toString() : undefined;
const publisher = {
  "@type": "Organization",
  name: siteSettings.siteName,
  ...(logoUrl ? { logo: { "@type": "ImageObject", url: logoUrl } } : {}),
};
const aboutItems = [industry, clientName].filter(Boolean);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CaseStudy",
  name: headline,
  description: summary || headline,
  url: canonical,
  ...(coverImage ? { image: toAbsolute(coverImage) } : {}),
  ...(aboutItems.length > 0 ? { about: aboutItems } : {}),
  ...(city ? { location: { "@type": "Place", name: city } } : {}),
  author: publisher,
  publisher,
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: toAbsolute("/") },
    { "@type": "ListItem", position: 2, name: "Casos", item: toAbsolute("/casos/") },
    { "@type": "ListItem", position: 3, name: clientName || pageTitle, item: canonical },
  ],
};

const fichaRows = [
  { label: "Cliente", value: clientName },
  { label: "Rubro", value: industry },
  { label: "Ciudad", value: city },
  { label: "Servicio", value: service },
].filter((row) => row.value);
---

<Layout
  title={seoTitle}
  description={summary || headline}
  image={coverImage || undefined}
  imageAlt={coverAlt}
  siteSettings={siteSettings}
  structuredData={[structuredData, breadcrumbSchema]}
>
  <Navbar siteSettings={siteSettings} navLinks={content.navLinks} />

  <main class="hero-safe-offset overflow-x-hidden pb-24">
    <!-- 1. Encabezado -->
    <section class="section-shell pt-10 pb-12 sm:pt-14">
      <a
        id="case-back-link"
        href="/casos"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-muted transition hover:text-content"
      >
        <Icon name="lucide:arrow-left" class="h-4 w-4" aria-hidden="true" />
        Todos los casos
      </a>

      <div class="mt-8 grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-center">
        <div class="space-y-6">
          <div class="flex items-center gap-4">
            {logo && (
              <img
                src={logo}
                alt={`Logo de ${clientName}`}
                class="h-14 w-14 shrink-0 rounded-xl border border-border/70 bg-white object-contain p-1.5"
                loading="eager"
              />
            )}
            <div>
              {clientName && <p class="text-lg font-semibold text-content">{clientName}</p>}
              <p class="text-sm text-muted">
                {[industry, city].filter(Boolean).join(" · ")}
              </p>
            </div>
          </div>

          {service && (
            <p class="pill w-fit">{service}</p>
          )}

          <h1 class="text-3xl font-bold leading-tight tracking-tight text-content [text-wrap:balance] sm:text-4xl lg:text-5xl">
            {headline}
          </h1>

          {summary && <p class="max-w-prose text-lg text-muted">{summary}</p>}

          <div class="flex flex-wrap gap-3">
            {whatsappUrl && (
              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 rounded-full bg-[#25D366] px-6 py-3 text-sm font-semibold text-white shadow-soft transition hover:shadow-lg"
              >
                <Icon name="simple-icons:whatsapp" class="h-4 w-4" aria-hidden="true" />
                Quiero algo así para mi negocio
              </a>
            )}
            {siteLink && (
              <a
                href={siteLink}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-full border border-border/70 bg-card px-6 py-3 text-sm font-semibold text-content transition hover:border-primary/50"
              >
                {siteIsSocial ? "Ver perfil" : "Ver sitio"}
                <Icon name="lucide:arrow-up-right" class="h-4 w-4" aria-hidden="true" />
              </a>
            )}
          </div>
        </div>

        <!-- 3. Imagen grande -->
        {coverImage && <DeviceMockup image={coverImage} alt={coverAlt} />}
      </div>
    </section>

    <!-- 2. Métricas (solo si hay números reales) -->
    {metrics.length > 0 && (
      <section class="section-shell pb-16" aria-labelledby="case-metrics-title">
        <h2 id="case-metrics-title" class="sr-only">Resultados</h2>
        <div
          class:list={[
            "grid gap-4",
            metrics.length === 1 ? "max-w-md" : metrics.length === 2 ? "sm:grid-cols-2" : "sm:grid-cols-3",
          ]}
        >
          {metrics.map((metric) => (
            <div class="rounded-2xl border border-border/70 bg-card p-6">
              <p class="text-4xl font-bold tracking-tight text-content sm:text-5xl">
                {metric.value}{metric.suffix && <span class="text-2xl">{metric.suffix}</span>}
              </p>
              {metric.before && (
                <p class="mt-1 text-sm text-muted">
                  Antes: {metric.before}{metric.suffix}
                </p>
              )}
              <p class="mt-3 text-sm font-medium text-muted">{metric.label}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- 4. Problema y lo que hicimos -->
    {(problemPoints.length > 0 || steps.length > 0 || donePoints.length > 0) && (
      <section class="section-shell grid gap-6 pb-16 lg:grid-cols-[0.8fr_1.2fr]">
        {problemPoints.length > 0 && (
          <div class="rounded-2xl border border-border/70 bg-card p-6 sm:p-8">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-muted">El problema</p>
            <ul class="mt-5 space-y-3 text-content">
              {problemPoints.map((text) => (
                <li class="flex items-start gap-3">
                  <Icon name="lucide:circle-alert" class="mt-0.5 h-5 w-5 shrink-0 text-rose-500" aria-hidden="true" />
                  <span>{text}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="rounded-2xl border border-border/70 bg-card p-6 sm:p-8">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-muted">Lo que hicimos</p>
          {steps.length > 0 ? (
            <ol class="mt-5 space-y-8">
              {steps.map((step, index) => (
                <li class="grid gap-4 sm:grid-cols-[auto_1fr]">
                  <span class="flex h-9 w-9 items-center justify-center rounded-full bg-primary/10 text-sm font-bold text-content">
                    {index + 1}
                  </span>
                  <div class="space-y-3">
                    <h3 class="font-semibold text-content">{step.title}</h3>
                    {step.text && <p class="text-muted">{step.text}</p>}
                    {step.image && (
                      <img
                        src={step.image}
                        alt={step.imageAlt ?? step.title}
                        class="w-full rounded-xl border border-border/70"
                        loading="lazy"
                      />
                    )}
                  </div>
                </li>
              ))}
            </ol>
          ) : (
            <ol class="mt-5 space-y-4">
              {donePoints.map((text, index) => (
                <li class="flex items-start gap-4">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary/10 text-sm font-bold text-content">
                    {index + 1}
                  </span>
                  <span class="pt-1 text-content">{text}</span>
                </li>
              ))}
            </ol>
          )}
        </div>
      </section>
    )}

    <!-- 5. Testimonio (solo si existe) -->
    {testimonial && (
      <section class="section-shell pb-16">
        <figure class="mx-auto max-w-3xl rounded-2xl border border-border/70 bg-card p-8 text-center sm:p-10">
          <Icon name="lucide:quote" class="mx-auto h-8 w-8 text-accent" aria-hidden="true" />
          <blockquote class="mt-4 text-xl font-medium leading-relaxed text-content [text-wrap:pretty]">
            “{testimonial.quote}”
          </blockquote>
          <figcaption class="mt-6 flex items-center justify-center gap-3">
            {testimonial.photo && (
              <img
                src={testimonial.photo}
                alt={testimonial.name}
                class="h-12 w-12 rounded-full object-cover"
                loading="lazy"
              />
            )}
            <span class="text-left">
              <span class="block font-semibold text-content">{testimonial.name}</span>
              {testimonial.role && <span class="block text-sm text-muted">{testimonial.role}</span>}
            </span>
          </figcaption>
        </figure>
      </section>
    )}

    <!-- 6. Ficha -->
    <section class="section-shell pb-16">
      <div class="rounded-2xl border border-border/70 bg-card p-6 sm:p-8">
        <h2 class="text-lg font-semibold text-content">Ficha del proyecto</h2>
        <dl class="mt-5 grid gap-x-8 gap-y-4 text-sm sm:grid-cols-2 lg:grid-cols-5">
          {fichaRows.map((row) => (
            <div>
              <dt class="text-muted">{row.label}</dt>
              <dd class="mt-0.5 font-semibold text-content">{row.value}</dd>
            </div>
          ))}
          {siteLink && (
            <div>
              <dt class="text-muted">{siteIsSocial ? "Perfil" : "Sitio"}</dt>
              <dd class="mt-0.5 font-semibold">
                <a
                  href={siteLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="break-all text-accent hover:underline dark:text-highlight"
                >
                  {siteLabel}
                </a>
              </dd>
            </div>
          )}
        </dl>
      </div>
    </section>

    <!-- 7. Siguiente caso + CTA -->
    <section class="section-shell">
      <div class="grid gap-6 lg:grid-cols-2">
        {nextCase && (
          <a
            href={`/casos/${nextCase.slug}`}
            class="group flex items-center gap-5 rounded-2xl border border-border/70 bg-card p-6 transition hover:border-primary/50"
          >
            {nextCase.coverImage && (
              <img
                src={nextCase.coverImage}
                alt=""
                class="h-20 w-28 shrink-0 rounded-lg object-cover object-left-top"
                loading="lazy"
              />
            )}
            <span class="min-w-0 flex-1">
              <span class="block text-xs font-semibold uppercase tracking-[0.2em] text-muted">Siguiente caso</span>
              <span class="mt-1 block font-semibold text-content">{nextCase.clientName}</span>
              <span class="block truncate text-sm text-muted">{nextCase.title}</span>
            </span>
            <Icon name="lucide:arrow-right" class="h-5 w-5 shrink-0 text-muted transition group-hover:translate-x-1 group-hover:text-content" aria-hidden="true" />
          </a>
        )}
        <div class="flex flex-col justify-center gap-4 rounded-2xl bg-slate-900 p-6 text-white sm:p-8">
          <p class="text-xl font-semibold">¿Quieres algo así para tu negocio?</p>
          <p class="text-white/70">Cuéntanos qué necesitas y te respondemos en 1 día hábil.</p>
          {whatsappUrl && (
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex w-fit items-center gap-2 rounded-full bg-[#25D366] px-6 py-3 text-sm font-semibold text-white transition hover:shadow-lg"
            >
              <Icon name="simple-icons:whatsapp" class="h-4 w-4" aria-hidden="true" />
              Quiero algo así para mi negocio
            </a>
          )}
        </div>
      </div>
    </section>
  </main>

  <Footer
    siteSettings={siteSettings}
    navLinks={content.navLinks}
    legalPages={content.legalPages}
  />
  <WhatsAppFloatingButton
    whatsappNumber={siteSettings.whatsappNumber}
    message={`Hola! Vi el caso de ${clientName || pageTitle} y quiero algo así para mi negocio.`}
  />
</Layout>
